<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <!-- Uchwyt BottomSheet -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@android:color/darker_gray"
        android:backgroundTint="?attr/colorOnSurface"
        android:alpha="0.3" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙️ Ustawienia importu"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Nazwa pliku -->
    <TextView
        android:id="@+id/tv_import_config_filename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Plik: —"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="20dp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Rok grafiku -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rok grafiku"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Rok (np. 2026)"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_import_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="4" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Rola użytkownika -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Twoja rola (do wyodrębnienia Twoich zmian)"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spinner_import_role"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:entries="@array/roles_array" />

    <!-- Tryb importu -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tryb importu"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <RadioGroup
        android:id="@+id/rg_import_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/rb_mode_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Aktualizuj grafik (zastąp auto-dane z tego pliku)"
            android:textSize="13sp"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rb_mode_merge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➕ Połącz z istniejącym (dodaj, nie usuwaj)"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_mode_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👁️ Podgląd bez zapisu"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- Przyciski -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_start_parse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Parsuj grafik"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp"
        style="@style/Widget.MaterialComponents.Button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel_config"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Anuluj"
        android:textAllCaps="false"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>
